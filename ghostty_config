# Configuración Ghostty: Cyberpunk Neon Edition
# Guardar en: ~/.config/ghostty/config

# --- 1. COMPORTAMIENTO Y PORTAPAPELES ---
copy-on-select = true

# --- 2. TIPOGRAFÍA HACKER ---
font-family = "JetBrainsMono Nerd Font"
font-size = 13

# --- 3. PALETA DE COLORES CYBERPUNK (CYAN & PURPLE/PINK) ---
background = 050508
foreground = aaf0d1

# Estructura dinámicamente intercalada (Púrpuras profundos, cianes eléctricos y magentas láser)
palette = 0=#13101c
palette = 1=#ff2a6d
palette = 2=#05d9e8
palette = 3=#ff007f
palette = 4=#7928ca
palette = 5=#d946ef
palette = 6=#00f2fe
palette = 7=#f3f4f6
palette = 8=#2c2640
palette = 9=#ff5c8d
palette = 10=#43ffaf
palette = 11=#ff70a6
palette = 12=#9d4edd
palette = 13=#f72585
palette = 14=#4cc9f0
palette = 15=#ffffff

# --- 4. CURSOR Y ESTÉTICA ---
cursor-style = block
cursor-style-blink = true
cursor-color = ff2a6d
cursor-text = 050508

background-opacity = 0.92
